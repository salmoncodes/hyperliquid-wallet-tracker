# Telegram Bot Token from @BotFather
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# (Optional) Restrict bot access to your Telegram user ID only
ADMIN_CHAT_ID=

# (Optional) Comma-separated list of additional allowed Telegram user IDs
TRACKER_ALLOWED_CHAT_IDS=

# (Optional) Minimum trade size in USD to trigger notifications (default: 0 = all trades)
DEFAULT_MIN_NOTIONAL=0

# (Optional) SQLite database path (default: ./data/tracker.sqlite for mainnet, ./data/tracker-testnet.sqlite for testnet)
# It is recommended to use separate database paths and bot tokens for mainnet vs testnet to avoid mixing state
TRACKER_DB_PATH=

# (Optional) Reconciliation interval in seconds (default: 60)
TRACKER_RECONCILE_INTERVAL_S=60

# (Optional) Hyperliquid Network: 'mainnet' or 'testnet' (default: mainnet)
HYPERLIQUID_NETWORK=mainnet

# (Optional) Custom WebSocket / HTTP API endpoints
# HYPERLIQUID_WS_URL=wss://api.hyperliquid.xyz/ws
# HYPERLIQUID_HTTP_URL=https://api.hyperliquid.xyz/info
